.config/pi/auth.json
.config/pi/extensions/

# TPM and its plugins (installed by install.sh). ~/.tmux is a stow symlink to
# this repo, so they'd otherwise land here as untracked files.
.tmux/plugins/

# Editor/tool backup files (e.g. Claude Code's settings.json.bak)
*.bak
.config/pi/models-store.json
/.config/pi/trust.json
/.config/pi/install
/.config/pi/bin
/.config/pi/git
/.local/

# Claude Code runtime state (sessions, caches, history, plugins...). Track only
# the hand-written config and the hook scripts settings.json points to.
/.claude/*
!/.claude/settings.json
!/.claude/notify.sh
!/.claude/tmux-window-name.sh

# ~/.config app state, caches and credentials (never commit these)
/.config/1Password/
/.config/configstore/
/.config/gcloud/
/.config/op/
/.config/mole/
/.config/pi/sessions/
/.config/cliamp/*.log
/.config/karabiner/automatic_backups/
# opencode: only the hand-edited config (service.json holds a password)
/.config/opencode/*
!/.config/opencode/opencode.jsonc
!/.config/opencode/cli.json
