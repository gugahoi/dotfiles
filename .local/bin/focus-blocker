#!/usr/bin/env bash
#
# focus-blocker - Redirect distracting domains to 0.0.0.0 in /etc/hosts
#
# Description:
#   Injects (or removes) a delimited block of hosts entries that sink the
#   domains listed in blocklist.txt to 0.0.0.0 / ::, then flushes the macOS
#   DNS cache. The delimited block means existing /etc/hosts entries are never
#   touched. Invoked by the "Work Focus - Block/Unblock" Shortcuts, which fire
#   on the Work Focus turning on/off (see README).
#
# Usage:
#   focus-blocker enable|on|start    : Sink blocklisted domains, flush DNS
#   focus-blocker disable|off|stop   : Remove the block, flush DNS
#   focus-blocker status             : Report whether the block is active
#   focus-blocker setup              : Install root-owned copies + sudo rule
#
# Editing /etc/hosts requires root, so `enable`/`disable` must run under sudo.
# `focus-blocker setup` installs a root-owned copy of this script at
# /usr/local/bin/focus-blocker plus a narrow passwordless-sudo rule (enable and
# disable only) so the Shortcuts can run it silently. Because the executed copy
# is root-owned, edit the source in your repo and re-run `focus-blocker setup`
# to resync. `status` reads world-readable /etc/hosts and needs no sudo.

set -euo pipefail

# Default to a fixed, root-owned config dir rather than $HOME/.config: under
# sudo, $HOME is often reset (e.g. to /var/root), so a home-relative path would
# break `enable`. FOCUS_BLOCKER_CONFIG_DIR overrides it for local testing.
CONFIG_DIR="${FOCUS_BLOCKER_CONFIG_DIR:-/usr/local/etc/focus-blocker}"
BLOCKLIST_FILE="${CONFIG_DIR}/blocklist.txt"
HOSTS_FILE="${FOCUS_BLOCKER_HOSTS_FILE:-/etc/hosts}"

START_MARKER="# --- BEGIN FOCUS BLOCKER ---"
END_MARKER="# --- END FOCUS BLOCKER ---"

# require_writable aborts unless the hosts file can be written, since
# enable/disable modify it. Tests the actual requirement (write access) rather
# than rootness, so it also works when pointed at a writable file for testing.
require_writable() {
	if [ ! -w "$HOSTS_FILE" ]; then
		echo "Error: '$1' cannot write $HOSTS_FILE (need root)." >&2
		echo "       Try: sudo $(basename "$0") $1" >&2
		exit 1
	fi
}

flush_dns() {
	dscacheutil -flushcache 2>/dev/null || true
	killall -HUP mDNSResponder 2>/dev/null || true
}

# remove_blocks deletes the delimited block (inclusive) if present. Safe to
# call when no block exists.
remove_blocks() {
	if grep -Fq "$START_MARKER" "$HOSTS_FILE"; then
		sed -i '' "/$START_MARKER/,/$END_MARKER/d" "$HOSTS_FILE"
	fi
}

enable_blocking() {
	require_writable enable
	if [ ! -f "$BLOCKLIST_FILE" ]; then
		echo "Error: Blocklist file not found at $BLOCKLIST_FILE" >&2
		exit 1
	fi

	# Ensure a clean slate so re-running enable never duplicates the block.
	remove_blocks

	local temp_file
	temp_file="$(mktemp)"

	echo "$START_MARKER" >> "$temp_file"
	while IFS= read -r domain || [ -n "$domain" ]; do
		# Strip trailing comments and surrounding whitespace.
		domain="$(echo "$domain" | sed -e 's/#.*$//' -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
		if [ -n "$domain" ]; then
			echo "0.0.0.0 $domain" >> "$temp_file"
			echo ":: $domain" >> "$temp_file"
		fi
	done < "$BLOCKLIST_FILE"
	echo "$END_MARKER" >> "$temp_file"

	cat "$temp_file" >> "$HOSTS_FILE"
	rm -f "$temp_file"

	flush_dns
	echo "Focus blocker: ENABLED"
}

disable_blocking() {
	require_writable disable
	remove_blocks
	flush_dns
	echo "Focus blocker: DISABLED"
}

status_blocking() {
	if grep -Fq "$START_MARKER" "$HOSTS_FILE"; then
		echo "Focus blocker is currently ACTIVE"
	else
		echo "Focus blocker is currently INACTIVE"
	fi
}

# setup_blocking installs root-owned copies of this script and the blocklist,
# plus a narrow passwordless-sudo rule, so the Shortcuts can run enable/disable
# silently without the executed code living in the user-writable repo. It reads
# the stowed sources from $HOME and escalates via sudo only for the privileged
# copy steps, so it must run as the normal user (not under sudo).
setup_blocking() {
	if [ "$(id -u)" -eq 0 ]; then
		echo "Error: run 'setup' as your normal user, not under sudo." >&2
		echo "       It reads sources from your home dir and prompts for sudo itself." >&2
		exit 1
	fi

	local user_name stowed_bin stowed_blocklist
	user_name="$(id -un)"
	stowed_bin="$HOME/.local/bin/focus-blocker"
	stowed_blocklist="$HOME/.config/focus-blocker/blocklist.txt"
	local target_bin_dir="/usr/local/bin"
	local target_bin="$target_bin_dir/focus-blocker"
	local target_config_dir="/usr/local/etc/focus-blocker"
	local target_blocklist="$target_config_dir/blocklist.txt"
	local sudoers_file="/etc/sudoers.d/focus-blocker"

	echo "==> Setting up Focus Blocker (hardened)..."

	# Sources must exist first, i.e. stow must have run.
	local src
	for src in "$stowed_bin" "$stowed_blocklist"; do
		if [ ! -e "$src" ]; then
			echo "Error: $src not found. Run 'stow .' (or 'stow -t ~ .') first." >&2
			exit 1
		fi
	done

	# Refuse a user-writable bin dir: a root-owned copy there would be pointless
	# if any user process could swap the whole file (catches Homebrew/Intel,
	# where /usr/local/bin is user-owned).
	if [ -d "$target_bin_dir" ] && [ -w "$target_bin_dir" ]; then
		echo "Error: $target_bin_dir is writable by $user_name." >&2
		echo "       A root-owned copy there would not be tamper-proof, so refusing." >&2
		echo "       (On Homebrew/Intel this dir is user-owned. Use a root-owned bin" >&2
		echo "        dir, or switch to the LaunchDaemon approach in the README.)" >&2
		exit 1
	fi

	echo "This will prompt for your password (sudo)."

	# Drop any stale symlink so we never execute through a user-writable link.
	if [ -L "$target_bin" ]; then
		sudo rm -f "$target_bin"
	fi

	# Copy the script and blocklist into root-owned locations. `install` follows
	# the stow symlink to read real content, but writes plain root-owned files.
	sudo install -d -o root -g wheel -m 0755 "$target_bin_dir"
	sudo install -o root -g wheel -m 0755 "$stowed_bin" "$target_bin"
	echo "Installed $target_bin (root:wheel 0755)"

	sudo install -d -o root -g wheel -m 0755 "$target_config_dir"
	sudo install -o root -g wheel -m 0644 "$stowed_blocklist" "$target_blocklist"
	echo "Installed $target_blocklist (root:wheel 0644)"

	# Narrow passwordless-sudo rule (enable/disable only), validated before it
	# goes live so a typo can never lock you out of sudo.
	echo "Configuring passwordless sudo (enable/disable only) for $target_bin..."
	local tmp_sudoers
	tmp_sudoers="$(mktemp)"
	printf '%s ALL=(ALL) NOPASSWD: %s enable, %s disable\n' \
		"$user_name" "$target_bin" "$target_bin" > "$tmp_sudoers"
	if sudo visudo -cf "$tmp_sudoers" >/dev/null; then
		sudo install -o root -g wheel -m 0440 "$tmp_sudoers" "$sudoers_file"
		echo "Installed $sudoers_file"
	else
		echo "Error: generated sudoers rule failed validation; not installing." >&2
		rm -f "$tmp_sudoers"
		exit 1
	fi
	rm -f "$tmp_sudoers"

	# Verify the installed copies are actually root-owned.
	echo "==> Verifying..."
	local f owner
	for f in "$target_bin" "$target_blocklist"; do
		owner="$(stat -f '%Su:%Sg' "$f")"
		printf '    %s  %s\n' "$owner" "$f"
		if [ "${owner%%:*}" != "root" ]; then
			echo "Warning: $f is not root-owned ($owner)." >&2
		fi
	done

	echo "==> Done! Test it with:"
	echo "    sudo focus-blocker enable"
	echo "    focus-blocker status        # no sudo needed"
	echo "    sudo focus-blocker disable"
	echo ""
	echo "After editing the script or blocklist in your repo, re-run"
	echo "'focus-blocker setup' to resync the root-owned copies."
}

case "${1:-}" in
	enable|on|start)
		enable_blocking
		;;
	disable|off|stop)
		disable_blocking
		;;
	status)
		status_blocking
		;;
	setup)
		setup_blocking
		;;
	*)
		echo "Usage: $(basename "$0") {enable|disable|status|setup}" >&2
		exit 1
		;;
esac
