#!/usr/bin/env bash
#
# setup-focus-blocker - Install root-owned focus-blocker + narrow sudo rule
#
# Description:
#   Stow symlinks the editable sources into your home dir:
#     ~/.local/bin/focus-blocker         (the script)
#     ~/.config/focus-blocker/blocklist.txt
#   This installer copies both into root-owned locations and wires up a narrow
#   passwordless-sudo rule so the Work Focus Shortcuts can run it silently:
#     1. Copy the script to /usr/local/bin/focus-blocker (root:wheel 0755).
#     2. Copy the blocklist to /usr/local/etc/focus-blocker/ (root:wheel 0644).
#     3. Install /etc/sudoers.d/focus-blocker granting NOPASSWD for the exact
#        `enable` and `disable` invocations only (validated with visudo first).
#
#   Run it once after `stow .`, and RE-RUN IT after editing the script or the
#   blocklist -- the root-owned copies are what actually execute:
#     .local/bin/setup-focus-blocker
#
# WHY COPIES, NOT SYMLINKS:
#   A passwordless-sudo rule that points at a symlink into your (user-writable)
#   repo would let anything running as you rewrite the script and gain root
#   without a prompt. Copying into a root-owned dir means the executed code
#   cannot be altered by a user-level process. `status` needs no sudo (it only
#   reads world-readable /etc/hosts).

set -euo pipefail

USER_NAME="$(id -un)"
STOWED_BIN="$HOME/.local/bin/focus-blocker"
STOWED_BLOCKLIST="$HOME/.config/focus-blocker/blocklist.txt"
TARGET_BIN_DIR="/usr/local/bin"
TARGET_BIN="$TARGET_BIN_DIR/focus-blocker"
TARGET_CONFIG_DIR="/usr/local/etc/focus-blocker"
TARGET_BLOCKLIST="$TARGET_CONFIG_DIR/blocklist.txt"
SUDOERS_FILE="/etc/sudoers.d/focus-blocker"

echo "==> Setting up Focus Blocker (hardened)..."

# 0. Sanity check: stow must have run first, so the sources exist to copy from.
for src in "$STOWED_BIN" "$STOWED_BLOCKLIST"; do
	if [ ! -e "$src" ]; then
		echo "Error: $src not found. Run 'stow .' (or 'stow -t ~ .') first." >&2
		exit 1
	fi
done

# 1. Safety gate: refuse to install into a user-writable bin dir. A root-owned
#    copy there would be pointless if any user process could swap the whole
#    file (this catches Homebrew/Intel, where /usr/local/bin is user-owned).
if [ -d "$TARGET_BIN_DIR" ] && [ -w "$TARGET_BIN_DIR" ]; then
	echo "Error: $TARGET_BIN_DIR is writable by $USER_NAME." >&2
	echo "       A root-owned copy there would not be tamper-proof, so refusing." >&2
	echo "       (On Homebrew/Intel this dir is user-owned. Use a root-owned bin" >&2
	echo "        dir, or switch to the LaunchDaemon approach in the README.)" >&2
	exit 1
fi

echo "This will prompt for your password (sudo)."

# 2. If an older version left a symlink here, remove it so we never execute
#    through a user-writable link again.
if [ -L "$TARGET_BIN" ]; then
	sudo rm -f "$TARGET_BIN"
fi

# 3. Copy the script into a root-owned dir as a root-owned file. `install`
#    follows the stow symlink to read the real content, but writes a plain,
#    root-owned regular file at the destination.
sudo install -d -o root -g wheel -m 0755 "$TARGET_BIN_DIR"
sudo install -o root -g wheel -m 0755 "$STOWED_BIN" "$TARGET_BIN"
echo "Installed $TARGET_BIN (root:wheel 0755)"

# 4. Copy the blocklist into a root-owned config dir.
sudo install -d -o root -g wheel -m 0755 "$TARGET_CONFIG_DIR"
sudo install -o root -g wheel -m 0644 "$STOWED_BLOCKLIST" "$TARGET_BLOCKLIST"
echo "Installed $TARGET_BLOCKLIST (root:wheel 0644)"

# 5. Install the narrow passwordless-sudo rule (enable/disable only), validating
#    before it goes live so a typo can never lock you out of sudo.
echo "Configuring passwordless sudo (enable/disable only) for $TARGET_BIN..."
tmp_sudoers="$(mktemp)"
printf '%s ALL=(ALL) NOPASSWD: %s enable, %s disable\n' \
	"$USER_NAME" "$TARGET_BIN" "$TARGET_BIN" > "$tmp_sudoers"
if sudo visudo -cf "$tmp_sudoers" >/dev/null; then
	sudo install -o root -g wheel -m 0440 "$tmp_sudoers" "$SUDOERS_FILE"
	echo "Installed $SUDOERS_FILE"
else
	echo "Error: generated sudoers rule failed validation; not installing." >&2
	rm -f "$tmp_sudoers"
	exit 1
fi
rm -f "$tmp_sudoers"

# 6. Verify the installed copies are actually root-owned.
echo "==> Verifying..."
for f in "$TARGET_BIN" "$TARGET_BLOCKLIST"; do
	owner="$(stat -f '%Su:%Sg' "$f")"
	printf '    %s  %s\n' "$owner" "$f"
	if [ "${owner%%:*}" != "root" ]; then
		echo "Warning: $f is not root-owned ($owner)." >&2
	fi
done

echo "==> Done! Test it with:"
echo "    sudo focus-blocker enable"
echo "    focus-blocker status        # no sudo needed"
echo "    sudo focus-blocker disable"
echo ""
echo "Remember: after editing the script or blocklist in your repo,"
echo "re-run 'setup-focus-blocker' to resync the root-owned copies."
