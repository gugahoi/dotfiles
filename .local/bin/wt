#!/usr/bin/env bash
#
# wt - Git Worktree Manager with Tmux integration
#
# Description:
#   This script automates Git worktree creation and navigation, pairing it 
#   with TMUX sessions. It provides an interactive fuzzy search selection (fzf)
#   for choosing branches and automatically creates worktrees and TMUX sessions 
#   if they don't already exist.
#
# Usage:
#   wt             : Interactively select a branch to switch to (creating worktree if needed)
#                    - Press [Ctrl-x] inside the selection menu to delete the worktree and branch
#                      (runs in the background; several deletions can run at once)
#   wt issue       : Pick an open GitHub issue and switch to (or create) a <number>-* branch for it
#   wt pr          : Pick an open GitHub pull request and switch to its branch
#                    - Press [Ctrl-t] inside either picker to switch between issues and pull requests
#   wt rm | delete : Interactively select a worktree to remove (with a confirmation prompt)
#   wt list        : List all active worktrees
#

set -u

# Resolve the absolute path of this script to ensure subprocesses (like fzf reload) can find it
SCRIPT_PATH=$(readlink -f "$0" 2>/dev/null || realpath "$0" 2>/dev/null || echo "$0")

# delete_branch_and_worktree finds and removes the worktree associated with the branch,
# and then deletes the local branch itself.
delete_branch_and_worktree() {
	local branch="$1"
	branch="${branch% \[wt\]}"
	[ -z "$branch" ] && return

	# 1. Find worktree path for this branch
	local worktree_path
	worktree_path=$(git worktree list --porcelain | awk -v branch="$branch" '
		$1 == "worktree" { path = substr($0, 10) }
		$1 == "branch" {
			ref = $2
			sub("^refs/heads/", "", ref)
			sub("^refs/remotes/origin/", "", ref)
			if (ref == branch) { print path; exit }
		}
	')

	# 2. If worktree exists, remove it
	if [ -n "$worktree_path" ]; then
		git worktree remove "$worktree_path" >/dev/null 2>&1 || git worktree remove --force "$worktree_path" >/dev/null 2>&1 || true
	fi

	# 3. Delete the local branch (allow extra time for packed-refs.lock held by concurrent deletions)
	git -c core.packedRefsTimeout=5000 branch -D "$branch" >/dev/null 2>&1 || true
}

# Background deletions keep per-repo state in the git common dir:
#   pending/<branch>  one marker per in-flight deletion (encoded branch name), containing
#                     the PID of the process doing the deletion
#   sessions/<pid>    one file per open `wt` picker, containing its fzf --listen socket path,
#                     so finished deletions can refresh every open picker
PENDING_SUFFIX=" [deleting…]"

state_dir() {
	local common
	common=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || return 1
	printf '%s/wt-state/%s' "$common" "$1"
}

# Branch names may contain '/', so encode them into flat file names
encode_branch() {
	local s="${1//\%/%25}"
	printf '%s' "${s//\//%2F}"
}
decode_branch() {
	local s="${1//\%2F//}"
	printf '%s' "${s//\%25/%}"
}

# list_pending prints branches with a deletion in flight, removing stale markers
# left behind by deletion processes that died.
list_pending() {
	local dir f pid
	dir=$(state_dir pending) || return 0
	for f in "$dir"/*; do
		[ -f "$f" ] || continue
		pid=$(<"$f")
		if [ -n "$pid" ] && ! kill -0 "$pid" 2>/dev/null; then
			rm -f "$f"
			continue
		fi
		decode_branch "${f##*/}"
		echo
	done
}

# notify_fzf asks every open `wt` picker of this repo to refresh its branch list,
# dropping registrations whose socket no longer exists.
notify_fzf() {
	local dir f sock
	dir=$(state_dir sessions) || return 0
	for f in "$dir"/*; do
		[ -f "$f" ] || continue
		sock=$(<"$f")
		if [ ! -S "$sock" ]; then
			rm -f "$f"
			continue
		fi
		curl -s --max-time 2 --unix-socket "$sock" http \
			-d "reload-sync(\"$SCRIPT_PATH\" --list-branches)" >/dev/null 2>&1 || true
	done
}

# cmd_delete_bg starts deleting a branch and its worktree in a detached background
# process and returns immediately, so several deletions can run concurrently.
cmd_delete_bg() {
	local branch="${1:-}" dir marker pid
	[ -z "$branch" ] && return 0
	dir=$(state_dir pending) || return 1
	mkdir -p "$dir" || return 1
	marker="$dir/$(encode_branch "$branch")"

	# Ignore if this branch is already being deleted
	if [ -f "$marker" ]; then
		pid=$(<"$marker")
		if [ -z "$pid" ] || kill -0 "$pid" 2>/dev/null; then
			return 0
		fi
	fi

	echo "$$" >"$marker"
	# Job control puts the job in its own process group so it isn't killed along with
	# fzf's child processes; it also ignores hangups/interrupts so it always completes.
	set -m
	(
		trap '' HUP INT TERM
		delete_branch_and_worktree "$branch"
		rm -f "$marker"
		notify_fzf
	) </dev/null >/dev/null 2>&1 &
	echo "$!" >"$marker"
}

# cmd_header prints the fzf header, including the number of in-flight deletions
cmd_header() {
	local n
	n=$(list_pending | grep -c .)
	printf 'Ctrl-X: Delete branch & worktree'
	[ "$n" -gt 0 ] && printf '   ⏳ Deleting %d branch(es)…' "$n"
	echo
}

# Helper to extract repo name from URL
get_repo_name() {
	local url="$1"
	local name="${url%.git}"
	name="${name##*/}"
	name="${name##*:}"
	echo "$name"
}

# cmd_clone clones a repo as bare and configures it for worktrees
cmd_clone() {
	local repo_url="${1:-}"
	if [ -z "$repo_url" ]; then
		echo "Usage: wt clone <repo_url> [<directory>]" >&2
		return 1
	fi

	local repo_name
	repo_name=$(get_repo_name "$repo_url")
	local target_dir="${2:-$repo_name}"

	if [ -e "$target_dir" ]; then
		echo "Error: Target directory '$target_dir' already exists." >&2
		return 1
	fi

	echo "Cloning bare repository into '$target_dir/.bare'..."
	mkdir -p "$target_dir" || return 1

	(
		cd "$target_dir" || exit 1
		git clone --bare "$repo_url" .bare || exit 1
		echo "gitdir: ./.bare" > .git
		git config remote.origin.fetch "+refs/heads/*:refs/remotes/origin/*"

		local primary_branch
		primary_branch=$(git --git-dir=.bare symbolic-ref --short HEAD 2>/dev/null || true)
		primary_branch="${primary_branch#refs/heads/}"

		if [ -z "$primary_branch" ]; then
			primary_branch="main"
		fi

		echo "Creating first worktree for branch '$primary_branch'..."
		git worktree add "$primary_branch" || exit 1

		local target_path session_name
		target_path="$(pwd -P)/$primary_branch"
		session_name=$(printf '%s' "$primary_branch" | tr '/.:' '___')

		if [ -n "${TMUX:-}" ]; then
			tmux has-session -t "=$session_name" 2>/dev/null || tmux new-session -d -s "$session_name" -c "$target_path" || exit 1
			tmux switch-client -t "=$session_name"
		else
			tmux new-session -A -s "$session_name" -c "$target_path"
		fi
	)
}

# cmd_delete allows interactive deletion of worktrees via a standalone subcommand
cmd_delete() {
	local selected
	selected=$(git worktree list | fzf --height 40% --prompt="Select worktree to delete> ")
	[ -z "$selected" ] && return 0

	local path branch
	path=$(echo "$selected" | awk '{print $1}')
	branch=$(echo "$selected" | awk '{print $3}' | tr -d '[]')

	echo "Are you sure you want to delete worktree at: $path and branch $branch? (y/N)"
	read -r response
	if [[ "$response" =~ ^([yY][eE][sS]|[yY])$ ]]; then
		delete_branch_and_worktree "$branch"
		echo "Worktree and branch removed."
	fi
}

# cmd_list_branches outputs all branches and appends [wt] if they have an active worktree,
# filtering out the current branch, and sorting active worktrees at the bottom.
# Branches with a deletion in flight are listed after the worktrees, tagged as deleting.
cmd_list_branches() {
	local wt_branches current_branch
	wt_branches=$(git worktree list --porcelain 2>/dev/null | awk '$1 == "branch" { sub("^refs/heads/", "", $2); print $2 }' || true)
	current_branch=$(git branch --show-current 2>/dev/null || true)

	export wt_list="$wt_branches"
	export current_branch="$current_branch"
	export pending_list="$(list_pending)"
	export pending_suffix="$PENDING_SUFFIX"
	git branch -a --format='%(refname:short)' 2>/dev/null | sed 's|^origin/||' | grep -vx HEAD | sort -u | awk '
		BEGIN {
			split(ENVIRON["wt_list"], lines, "\n")
			for (i in lines) {
				if (lines[i] != "") {
					wt[lines[i]] = 1
				}
			}
			split(ENVIRON["pending_list"], lines, "\n")
			for (i in lines) {
				if (lines[i] != "") {
					pending[lines[i]] = 1
				}
			}
			cur = ENVIRON["current_branch"]
			suffix = "\033[33m" ENVIRON["pending_suffix"] "\033[0m"
			wt_count = 0
			pending_count = 0
			regular_count = 0
		}
		{
			if ($0 == cur || $0 == "") {
				next
			}
			if ($0 in pending) {
				pending_lines[pending_count++] = $0 suffix
			} else if ($0 in wt) {
				wt_lines[wt_count++] = $0 " [wt]"
			} else {
				regular_lines[regular_count++] = $0
			}
		}
		END {
			for (i = 0; i < wt_count; i++) {
				print wt_lines[i]
			}
			for (i = 0; i < pending_count; i++) {
				print pending_lines[i]
			}
			for (i = 0; i < regular_count; i++) {
				print regular_lines[i]
			}
		}
	'
}

# cmd_switch lists all branches, allowing switching/creating with Ctrl-X keybinding for deletion
cmd_switch() {
	local branch sock_dir sessions session_file=""
	# Ctrl-X spawns a background deletion and returns immediately, so several deletions
	# can run concurrently. This picker registers its fzf --listen socket so finished
	# deletions can make it reload; the header is refreshed after every (re)load.
	sock_dir=$(mktemp -d "${TMPDIR:-/tmp}/wt.XXXXXX") || return 1
	if sessions=$(state_dir sessions) && mkdir -p "$sessions"; then
		session_file="$sessions/$$"
		echo "$sock_dir/fzf.sock" >"$session_file"
	fi
	branch=$("$SCRIPT_PATH" --list-branches | fzf --ansi --print-query --prompt="Branch> " \
		--listen="$sock_dir/fzf.sock" \
		--header="$(cmd_header)" \
		--bind "ctrl-x:execute-silent(\"$SCRIPT_PATH\" --delete-branch-bg {1})+reload-sync(\"$SCRIPT_PATH\" --list-branches)" \
		--bind "load:transform-header(\"$SCRIPT_PATH\" --header)" | awk '
		NR == 1 { query = $0; next }
		{ selected = $0 }
		END { print (selected != "" ? selected : query) }
	')
	[ -n "$session_file" ] && rm -f "$session_file"
	rm -rf "$sock_dir"
	switch_to_branch "$branch"
}

# switch_to_branch takes a branch picked in fzf (possibly tagged [wt] or deleting) and switches
# to its tmux session, creating the worktree - and the branch, off a freshly fetched
# origin/<default> - when missing.
switch_to_branch() {
	local branch="$1" default_branch base local_branch target_path
	if [[ "$branch" == *"$PENDING_SUFFIX" ]]; then
		echo "wt: '${branch%"$PENDING_SUFFIX"}' is being deleted" >&2
		return 1
	fi
	branch="${branch% \[wt\]}"
	[ -z "$branch" ] && return 0
	git check-ref-format --branch "$branch" >/dev/null 2>&1 || return 1
	local_branch=$(git branch --format='%(refname:short)' 2>/dev/null | grep -Fx "$branch" || true)

	local git_common_dir bare_worktree worktree_root worktree_path
	git_common_dir=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || return 1
	bare_worktree=$(git worktree list --porcelain | awk -v common_dir="$git_common_dir" '
		$1 == "worktree" { path = substr($0, 10) }
		$1 == "bare" && path == common_dir { print path; exit }
	')
	worktree_root=${bare_worktree:-$git_common_dir}
	worktree_root=${worktree_root%/*}
	worktree_path="$worktree_root/$branch"

	# Check if worktree already exists
	local existing
	existing=$(git worktree list --porcelain | awk -v branch="$branch" '
		$1 == "worktree" { path = substr($0, 10) }
		$1 == "branch" {
			ref = $2
			sub("^refs/heads/", "", ref)
			sub("^refs/remotes/origin/", "", ref)
			if (ref == branch) { print path; exit }
		}
	')
	if [ -n "$existing" ]; then
		target_path="$existing"
	else
		if [ -d "$worktree_path" ] && git -C "$worktree_path" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
			target_path="$worktree_path"
		else
			mkdir -p "${worktree_path%/*}" || return 1
			if [ -n "$local_branch" ]; then
				git worktree add "$worktree_path" "$branch" || return 1
			else
				default_branch=$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null | sed 's|^origin/||' || true)
				default_branch=${default_branch:-$(git branch --format='%(refname:short)' 2>/dev/null | grep -Fx main || true)}
				default_branch=${default_branch:-$(git branch --format='%(refname:short)' 2>/dev/null | grep -Fx master || true)}
				# New branches start from the latest origin/<default> (or the last fetched one when
				# offline) and don't track it, so the first push sets up origin/<branch>
				git worktree add "$worktree_path" "$branch" 2>/dev/null || {
					git fetch --quiet origin "$default_branch" || echo "wt: fetch failed, branching from last known origin/$default_branch" >&2
					base="origin/$default_branch"
					git rev-parse --verify --quiet "$base^{commit}" >/dev/null || base=$default_branch
					git worktree add --no-track -b "$branch" "$worktree_path" "$base"
				} || return 1
			fi
			target_path="$worktree_path"
		fi
	fi

	local session_name
	session_name=$(printf '%s' "$branch" | tr '/.:' '___')

	if [ -n "${TMUX:-}" ]; then
		tmux has-session -t "=$session_name" 2>/dev/null || tmux new-session -d -s "$session_name" -c "$target_path" || return 1
		tmux switch-client -t "=$session_name"
	else
		tmux new-session -A -s "$session_name" -c "$target_path"
	fi
}

# GitHub is slow (seconds per call), so `wt issue` and `wt pr` keep a per-repo cache in the git common dir:
#   issues                     open issues, one "number<TAB>updatedAt<TAB>title<TAB>labels" per line
#   prs                        open pull requests, one "number<TAB>updatedAt<TAB>isDraft<TAB>isCrossRepository
#                              <TAB>branch<TAB>title<TAB>author<TAB>labels" per line
#   previews/<n>-<updatedAt>   rendered `gh issue view` / `gh pr view`, replaced once the issue/PR changes
#                              (issues and PRs share one number sequence)

# wt_error reports an error on stderr and tmux's status line, since the popup closes as soon as wt exits
wt_error() {
	echo "wt: ${1%%$'\n'*}" >&2
	[ -n "${TMUX:-}" ] && tmux display-message "wt: ${1%%$'\n'*}"
}

# fetch_issues refreshes the cached issue list, keeping the old one if GitHub can't be reached
fetch_issues() {
	local cache
	cache=$(state_dir issues) || { echo "not a git repository" >&2; return 1; }
	mkdir -p "${cache%/*}" || return 1
	if gh issue list --state open --limit 500 --json number,updatedAt,title,labels \
		--jq '.[] | "\(.number)\t\(.updatedAt)\t\(.title)\t\(.labels | map(.name) | join(","))"' >"$cache.$$"; then
		mv "$cache.$$" "$cache"
	else
		rm -f "$cache.$$"
		return 1
	fi
}

# cmd_issue_lines prints the cached issues for fzf as "issue<TAB>number<TAB>updatedAt<TAB>display",
# those with a <number>-* branch first.
cmd_issue_lines() {
	local cache
	cache=$(state_dir issues) && [ -f "$cache" ] || return 0
	branches="$(cmd_list_branches)" awk -F'\t' '
		BEGIN {
			n = split(ENVIRON["branches"], b, "\n")
			for (i = 1; i <= n; i++) {
				if (!match(b[i], /^[0-9]+-/)) continue
				num = substr(b[i], 1, RLENGTH - 1)
				if (b[i] ~ / \[wt\]$/) mark[num] = " [wt]"
				else if (!(num in mark)) mark[num] = " [br]"
			}
		}
		$1 !~ /^[0-9]+$/ { next }
		{
			line = "issue\t" $1 "\t" $2 "\t#" $1 (($1 in mark) ? mark[$1] : "") "  " $3 ($4 != "" ? "  \033[2m[" $4 "]\033[0m" : "")
			if ($1 in mark) print line; else rest[r++] = line
		}
		END { for (i = 0; i < r; i++) print rest[i] }
	' "$cache"
}

# cmd_preview prints an issue or PR as `gh issue view` / `gh pr view` renders it, cached until its updatedAt
# changes. Renders cut short by fzf killing the preview leave a .<n>.<pid> file, cleared next time.
cmd_preview() {
	local kind="$1" n="$2" updated="$3" file dir tmp
	[ "$kind" = issue ] || [ "$kind" = pr ] || return 1
	dir=$(state_dir previews) || return 1
	file="$dir/$n-$updated"
	if [ ! -s "$file" ]; then
		mkdir -p "$dir" || return 1
		rm -f "$dir/.$n".*
		tmp="$dir/.$n.$$"
		GH_FORCE_TTY=${FZF_PREVIEW_COLUMNS:-80} GH_PAGER=cat gh "$kind" view "$n" >"$tmp" 2>&1 || { cat "$tmp"; rm -f "$tmp"; return 1; }
		rm -f "$dir/$n"-*
		mv "$tmp" "$file"
	fi
	cat "$file"
}

# refresh fetches the issues or PRs from GitHub, at most once per picker: kinds already fetched
# are marked in the $WT_REFRESHED directory, so switching back and forth doesn't refetch.
refresh() {
	local kind="$1"
	[ -n "${WT_REFRESHED:-}" ] && [ -e "$WT_REFRESHED/$kind" ] && return 0
	case $kind in
	issue) fetch_issues ;;
	pr) fetch_prs ;;
	*) return 1 ;;
	esac || return 1
	[ -n "${WT_REFRESHED:-}" ] && touch "$WT_REFRESHED/$kind"
	return 0
}

# picker_kind prints what the picker is showing (issue or pr), read from fzf's prompt
picker_kind() {
	case "${FZF_PROMPT:-}" in
	PR*) echo pr ;;
	*) echo issue ;;
	esac
}

# picker_header prints the picker's header for the given kind
picker_header() {
	case $1 in
	issue) echo "Ctrl-T: switch to pull requests" ;;
	pr) echo "Ctrl-T: switch to issues" ;;
	esac
}

# cmd_lines prints the cached issues or PRs for fzf - the given kind, or else the one the picker
# is showing; with --refresh it fetches them from GitHub first.
cmd_lines() {
	local refresh="" kind
	[ "${1:-}" = --refresh ] && { refresh=1; shift; }
	kind=${1:-$(picker_kind)}
	[ -n "$refresh" ] && refresh "$kind" 2>/dev/null
	case $kind in
	issue) cmd_issue_lines ;;
	pr) cmd_pr_lines ;;
	esac
}

# cmd_toggle prints the fzf actions switching the picker between issues and PRs. load is rebound
# so the switched-to list, shown from the cache straight away, gets refreshed from GitHub.
cmd_toggle() {
	local kind=issue prompt="Issue> "
	[ "$(picker_kind)" = issue ] && { kind=pr; prompt="PR> "; }
	echo "change-prompt($prompt)+change-header($(picker_header "$kind"))+rebind(load)+reload-sync(\"$SCRIPT_PATH\" --lines $kind)"
}

# cmd_github lists the repo's open GitHub issues or PRs, Ctrl-T switching between them, and opens the
# picked one. The cached list shows straight away and is swapped for a fresh one once GitHub answers
# (load is unbound first so the reload doesn't retrigger it); only a first run waits on GitHub.
cmd_github() {
	local kind="$1" prompt="Issue> " err line n
	[ "$kind" = pr ] && prompt="PR> "
	WT_REFRESHED=$(mktemp -d "${TMPDIR:-/tmp}/wt.XXXXXX") || return 1
	export WT_REFRESHED
	if [ ! -s "$(state_dir "${kind}s")" ] && ! err=$(refresh "$kind" 2>&1); then
		rm -rf "$WT_REFRESHED"
		wt_error "$err"
		return 1
	fi
	line=$(cmd_lines "$kind" | fzf --ansi --prompt="$prompt" --header="$(picker_header "$kind")" \
		--delimiter='\t' --with-nth=4.. \
		--bind "load:unbind(load)+reload-sync(\"$SCRIPT_PATH\" --lines --refresh)" \
		--bind "ctrl-t:transform(\"$SCRIPT_PATH\" --toggle)" \
		--preview "\"$SCRIPT_PATH\" --preview {1} {2} {3}" \
		--preview-window 'right,50%,wrap')
	rm -rf "$WT_REFRESHED"
	[ -z "$line" ] && return 0
	IFS=$'\t' read -r kind n _ <<<"$line"
	case $kind in
	issue) open_issue "$n" ;;
	pr) open_pr "$n" ;;
	esac
}

# open_issue offers the issue's existing <number>-* branches or a new one named in an editable
# prompt, and switches to it.
open_issue() {
	local n="$1" title matches branch new="+ new branch"
	branch=$new
	matches=$(cmd_list_branches | grep "^$n-" || true)
	if [ -n "$matches" ]; then
		branch=$(printf '%s\n%s\n' "$new" "$matches" | fzf --ansi --no-sort --prompt="#$n> ") || return 0
	fi
	if [ "$branch" = "$new" ]; then
		title=$(awk -F'\t' -v n="$n" '$1 == n { print $3; exit }' "$(state_dir issues)")
		title=$(printf '%s' "$title" | tr '[:upper:]' '[:lower:]' | tr -cs 'a-z0-9' '-' | sed 's/^-//' | cut -d- -f1-5 | sed 's/-$//')
		branch=$(fzf --prompt="New branch> " --info=hidden --query="$n-$title" --bind=enter:print-query </dev/null) || return 0
		[ -z "$branch" ] && return 0
		[[ "$branch" == "$n-"* ]] || branch="$n-$branch"
	fi
	switch_to_branch "$branch"
}

# fetch_prs refreshes the cached pull request list - ready for review oldest first, then drafts
# oldest first - keeping the old one if GitHub can't be reached. PRs from forks are checked out
# into a local pr-<number> branch, since their head branch doesn't exist on origin.
fetch_prs() {
	local cache
	cache=$(state_dir prs) || { echo "not a git repository" >&2; return 1; }
	mkdir -p "${cache%/*}" || return 1
	if gh pr list --state open --limit 500 \
		--json number,createdAt,updatedAt,isDraft,isCrossRepository,headRefName,title,author,labels \
		--jq 'sort_by([.isDraft, .createdAt]) | .[] | "\(.number)\t\(.updatedAt)\t\(.isDraft)\t\(.isCrossRepository)\t\(if .isCrossRepository then "pr-\(.number)" else .headRefName end)\t\(.title)\t\(.author.login)\t\(.labels | map(.name) | join(","))"' >"$cache.$$"; then
		mv "$cache.$$" "$cache"
	else
		rm -f "$cache.$$"
		return 1
	fi
}

# cmd_pr_lines prints the cached PRs for fzf as "pr<TAB>number<TAB>updatedAt<TAB>display", marking
# those whose branch has a worktree [wt] or exists locally [br].
cmd_pr_lines() {
	local cache
	cache=$(state_dir prs) && [ -f "$cache" ] || return 0
	wt_branches="$(git worktree list --porcelain 2>/dev/null | awk '$1 == "branch" { sub("^refs/heads/", "", $2); print $2 }')" \
	local_branches="$(git branch --format='%(refname:short)' 2>/dev/null)" awk -F'\t' '
		BEGIN {
			n = split(ENVIRON["local_branches"], b, "\n")
			for (i = 1; i <= n; i++) if (b[i] != "") mark[b[i]] = " [br]"
			n = split(ENVIRON["wt_branches"], b, "\n")
			for (i = 1; i <= n; i++) if (b[i] != "") mark[b[i]] = " [wt]"
		}
		$1 !~ /^[0-9]+$/ { next }
		{
			print "pr\t" $1 "\t" $2 "\t#" $1 (($5 in mark) ? mark[$5] : "") ($3 == "true" ? "  \033[33m[draft]\033[0m" : "") "  " $6 \
				"  \033[2m@" $7 ($8 != "" ? " [" $8 "]" : "") "\033[0m"
		}
	' "$cache"
}

# open_pr switches to the PR's branch, fetching it from GitHub when there's no local branch yet.
open_pr() {
	local n="$1" err cross branch
	IFS=$'\t' read -r cross branch < <(awk -F'\t' -v n="$n" '$1 == n { print $4 "\t" $5; exit }' "$(state_dir prs)")
	[ -z "${branch:-}" ] && return 0

	if ! git show-ref --verify --quiet "refs/heads/$branch"; then
		if [ "$cross" = true ]; then
			err=$(git fetch --quiet origin "+refs/pull/$n/head:refs/heads/$branch" 2>&1)
		else
			err=$(git fetch --quiet origin "+refs/heads/$branch:refs/remotes/origin/$branch" 2>&1 &&
				git branch --quiet --track "$branch" "origin/$branch" 2>&1)
		fi || {
			wt_error "failed to fetch PR #$n: ${err:-unknown error}"
			return 1
		}
	fi
	switch_to_branch "$branch"
}

# show_help prints the command usage and details
show_help() {
	echo "wt - Git Worktree Manager with Tmux integration"
	echo
	echo "Usage:"
	echo "  wt                  Interactively select a branch to switch to (creating worktree if needed)"
	echo "                      - Press [Ctrl-x] inside the selection menu to delete the worktree and branch"
	echo "                        (runs in the background; several deletions can run at once)"
	echo "  wt issue            Pick an open GitHub issue and switch to (or create) a <number>-* branch for it"
	echo "  wt pr               Pick an open GitHub pull request (ready first, then drafts; oldest first) and switch to its branch"
	echo "                      - Press [Ctrl-t] inside either picker to switch between issues and pull requests"
	echo "  wt clone <url> [dir] Clone a repository as bare and set up worktrees"
	echo "  wt rm | delete      Interactively select a worktree to remove (with a confirmation prompt)"
	echo "  wt list             List all active worktrees"
	echo "  wt -h | --help      Show this help documentation"
}

# Main command dispatcher
case "${1:-}" in
--list-branches)
	cmd_list_branches
	;;
--delete-branch-bg)
	cmd_delete_bg "${2:-}"
	;;
--header)
	cmd_header
	;;
--lines)
	cmd_lines "${2:-}" "${3:-}"
	;;
--toggle)
	cmd_toggle
	;;
--preview)
	cmd_preview "${2:-}" "${3:-}" "${4:-}"
	;;
issue | pr)
	cmd_github "$1"
	;;
clone)
	cmd_clone "${2:-}" "${3:-}"
	;;
rm | delete)
	cmd_delete
	;;
list)
	git worktree list
	;;
-h | --help)
	show_help
	;;
*)
	cmd_switch
	;;
esac
